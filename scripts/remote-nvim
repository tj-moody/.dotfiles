#!/usr/bin/env bash

set -euo pipefail

log() {
  local level="$1" msg="$2"
  if command -v gum >/dev/null 2>&1; then
    gum log -l "$level" "$msg"
  else
    echo "[$level] $msg"
  fi
}

PORT=6666
TRIES=20        # ~6s at 0.3s/try (default)
HOST=""

while [ $# -gt 0 ]; do
  case "$1" in
    -w|--wait)
      TRIES=200   # ~60s, enough for manual 2FA
      shift
      ;;
    *)
      HOST="$1"
      shift
      ;;
  esac
done
HOST="${HOST:-saltie}"

if [ -n "${TMUX:-}" ]; then
    log error "Please run outside of tmux"
    exit 1
fi

cleanup() {
    log info "Closing tunnel..."
    [ -n "${TUNNEL_PID:-}" ] && kill "$TUNNEL_PID" 2>/dev/null
}
trap cleanup EXIT INT TERM

pkill -f "ssh -N -L $PORT:127.0.0.1:$PORT $HOST" 2>/dev/null || true

ssh -N -L "$PORT:127.0.0.1:$PORT" "$HOST" &
TUNNEL_PID=$!

log info "Waiting for tunnel to $HOST:$PORT..."
ready=0
for _ in $(seq 1 "$TRIES"); do
    if (echo > "/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
        ready=1
        break
    fi
    sleep 0.3
done

if [ "$ready" -eq 0 ]; then
    log error "Could not reach nvim on $HOST:$PORT — did you start nvim-host?"
    exit 1
fi

log info "Connecting to nvim on $HOST:$PORT"
nvim --remote-ui --server "127.0.0.1:$PORT"
