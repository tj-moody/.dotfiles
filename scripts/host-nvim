#!/usr/bin/env bash

set -euo pipefail
PORT=6666

pkill -f "nvim --headless --listen 127.0.0.1:$PORT" 2>/dev/null || true

fullpath=$(pick-project) || exit 0

gum log -l info "Starting headless nvim in $fullpath on :$PORT"
cd "$fullpath"
setsid nohup nvim --headless --listen "127.0.0.1:$PORT" </dev/null >/tmp/nvim-headless.log 2>&1 &
disown

gum log -l info "nvim running detached (pid $!) — safe to close this shell"
