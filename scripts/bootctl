#!/usr/bin/env bash

boot-saltie() {
    ssh poncho 'schtasks /run /tn boot-debian'
}

boot-poncho() {
    ssh saltie 'sudo /usr/local/bin/boot-poncho --force'
}


bootctl_screen() {
    source "$HOME"/.dotfiles/.env

    poncho_up=0
    saltie_up=0

    status=$(curl -sLX GET \
    "https://api.cloudflare.com/client/v4/accounts/570eece936b8f69d1370643a3239e9be/cfd_tunnel/93a288a6-31bf-4b59-889f-93c74e1a49d5" \
    -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" |
    jq -r '.result.status')

    [[ "$status" == "healthy" ]] && saltie_up=1
    status=$(curl -sLX GET \
    "https://api.cloudflare.com/client/v4/accounts/570eece936b8f69d1370643a3239e9be/cfd_tunnel/d80ee840-872a-40a2-b40f-14c8a4b96420" \
    -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" |
    jq -r '.result.status')

    [[ "$status" == "healthy" ]] && poncho_up=1

    clear

    echo -n "Windows (poncho)  "
    if (( poncho_up )); then
        gum style --foreground="2" "● online"
    else
        gum style --foreground="1" "○ offline"
    fi

    echo -n "Debian  (saltie)  "
    if (( saltie_up )); then
        gum style --foreground="2" "● online"
    else
        gum style --foreground="1" "○ offline"
    fi

    echo

    if (( !poncho_up && !saltie_up )); then
        gum style --foreground 3 \
            "  Neither responded — machine may be mid-reboot, or the tunnel is down."

        echo
        read -r -p "  Press Enter to return..." _

        return 1
    fi

    local -a options=()

    if (( poncho_up && !saltie_up )); then
        options+=("Switch to Debian")
    elif (( saltie_up && !poncho_up )); then
        options+=("Switch to Windows")
    else
        options+=("Switch to Windows")
        options+=("Switch to Debian")
    fi

    options+=("Refresh" "Quit")

    case "$(gum choose "${options[@]}")" in
        "Switch to Windows")
            if gum confirm "Reboot into Windows now?"; then
                boot-poncho
                gum style --foreground="2" \
                "Triggered — give it a minute, then run 'bootctl' again to confirm."
            fi
            ;;

        "Switch to Debian")
            if gum confirm "Reboot into Debian now?"; then
                boot-saltie
                gum style --foreground="2" \
                "Triggered — give it a minute, then run 'bootctl' again to confirm."
            fi
            ;;

        "Refresh")
            bootctl_screen
            ;;

        "Quit")
            return 0
            ;;
    esac
}

printf '\e[?1049h'
bootctl_screen
printf '\e[?1049l'
